        <div class="field"><label for="vehicle">Vehículo</label><input id="vehicle" name="vehicle" placeholder="Marca, modelo y año" required></div>
        <div class="field"><label for="service">Servicio que necesitas</label><select id="service" name="service" required><option value="">Selecciona un servicio</option><option>Mecánica general</option><option>Cambio de aceite y filtro</option><option>Afinación menor</option><option>Afinación mayor</option><option>Frenos</option><option>Suspensión y dirección</option><option>Diagnóstico con escáner</option><option>Clutch / embrague</option><option>Sistema eléctrico</option><option>Otro / No estoy seguro</option></select></div>
