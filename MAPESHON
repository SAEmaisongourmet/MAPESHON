<script>
const services = [
 {name:'Revisión mecánica general',cat:'Mantenimiento',icon:'⚙',desc:'Inspección general de componentes, niveles y puntos de seguridad.',price:'Desde $350',unit:'revisión básica'},
 {name:'Cambio de aceite y filtro',cat:'Mantenimiento',icon:'◉',desc:'Servicio de cambio de aceite y filtro. Lubricantes y filtro se cotizan según motor.',price:'Desde $350',unit:'mano de obra'},
 {name:'Afinación menor',cat:'Mantenimiento',icon:'🔧',desc:'Servicio básico de mantenimiento según especificaciones del vehículo.',price:'Desde $700',unit:'mano de obra'},
 {name:'Afinación mayor',cat:'Motor',icon:'⚙',desc:'Mantenimiento más completo; bujías, filtros y consumibles según vehículo.',price:'Desde $1,500',unit:'mano de obra'},
 {name:'Diagnóstico con escáner',cat:'Eléctrico',icon:'▣',desc:'Lectura de códigos y revisión inicial de sistemas electrónicos.',price:'Desde $400',unit:'diagnóstico'},
 {name:'Cambio de balatas delanteras',cat:'Frenos',icon:'◉',desc:'Desmontaje, instalación y revisión del sistema delantero.',price:'Desde $650',unit:'mano de obra'},
 {name:'Servicio de frenos traseros',cat:'Frenos',icon:'◉',desc:'Revisión, limpieza y cambio de componentes según desgaste.',price:'Desde $750',unit:'mano de obra'},
 {name:'Rectificado de discos',cat:'Frenos',icon:'◎',desc:'Sujeto a medición de espesor y condición del disco.',price:'Desde $650',unit:'por eje · referencia'},
 {name:'Cambio de amortiguadores',cat:'Suspensión',icon:'↕',desc:'Instalación de amortiguadores; piezas y alineación no incluidas.',price:'Desde $1,300',unit:'mano de obra · par'},
 {name:'Revisión de suspensión',cat:'Suspensión',icon:'⚒',desc:'Inspección de bujes, rótulas, terminales y amortiguadores.',price:'Desde $350',unit:'revisión'},
 {name:'Cambio de clutch / embrague',cat:'Motor',icon:'⚙',desc:'Desmontaje e instalación. El precio depende del modelo y acceso.',price:'Desde $3,500',unit:'mano de obra'},
 {name:'Servicio de sistema eléctrico',cat:'Eléctrico',icon:'ϟ',desc:'Revisión de carga, batería, marcha, alternador y circuitos.',price:'Desde $450',unit:'diagnóstico inicial'},
 {name:'Cambio de banda de distribución',cat:'Motor',icon:'⟳',desc:'Trabajo sujeto a motor, acceso y componentes que deban sustituirse.',price:'Desde $2,000',unit:'mano de obra'},
 {name:'Cambio de líquido de frenos',cat:'Frenos',icon:'◉',desc:'Renovación y purga del sistema. Líquido se cotiza aparte.',price:'Desde $450',unit:'mano de obra'},
 {name:'Reparación de fugas',cat:'Motor',icon:'⌁',desc:'Detección y reparación de fugas de aceite o refrigerante según diagnóstico.',price:'Desde $500',unit:'mano de obra inicial'},
 {name:'Afinación / limpieza de inyectores',cat:'Motor',icon:'✣',desc:'Limpieza y revisión del sistema de inyección según procedimiento requerido.',price:'Desde $600',unit:'servicio básico'},
 {name:'Servicio de transmisión',cat:'Motor',icon:'⚙',desc:'Revisión y diagnóstico de transmisión manual o automática.',price:'Desde $500',unit:'diagnóstico'},
 {name:'Aire acondicionado',cat:'Eléctrico',icon:'❄',desc:'Diagnóstico inicial de funcionamiento y posibles fugas.',price:'Desde $450',unit:'diagnóstico'}
];
const grid=document.getElementById('serviceGrid');
function render(filter='Todos'){
 grid.innerHTML='';
 services.filter(s=>filter==='Todos'||s.cat===filter).forEach(s=>{
  const card=document.createElement('article'); card.className='service-card';
  card.innerHTML=`<div class="service-icon">${s.icon}</div><h3>${s.name}</h3><p>${s.desc}</p><div class="price-row"><div class="price"><small>${s.unit}</small>${s.price}</div><a class="quote-link" href="#contacto" data-service="${s.name}">COTIZAR ↗</a></div>`;
  grid.appendChild(card);
 });
 grid.querySelectorAll('[data-service]').forEach(a=>a.addEventListener('click',()=>{document.getElementById('service').value=a.dataset.service;}));
}
document.getElementById('filters').addEventListener('click',e=>{const b=e.target.closest('button[data-filter]');if(!b)return;document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');render(b.dataset.filter);});
document.getElementById('quoteForm').addEventListener('submit',e=>{
 e.preventDefault(); const d=new FormData(e.currentTarget);
 const msg=`Hola MAPESHON, quiero solicitar una cotización.%0A%0ANombre: ${encodeURIComponent(d.get('name'))}%0AVehículo: ${encodeURIComponent(d.get('vehicle'))}%0AServicio: ${encodeURIComponent(d.get('service'))}%0ADetalles: ${encodeURIComponent(d.get('details')||'Sin detalles adicionales')}`;
 window.open(`https://wa.me/529931181321?text=${msg}`,'_blank','noopener');
});
document.getElementById('year').textContent=new Date().getFullYear();render();

// Reseñas: se guardan en este navegador mediante almacenamiento local.
const REVIEW_STORAGE_KEY = 'mapeshon_reviews_v1';
function loadReviews() {
  try {
    const data = JSON.parse(localStorage.getItem(REVIEW_STORAGE_KEY) || '[]');
    return Array.isArray(data) ? data : [];
  } catch (error) { return []; }
}
function renderReviews() {
  const reviews = loadReviews();
  const total = reviews.length;
  const average = total ? reviews.reduce((sum, item) => sum + Number(item.rating || 0), 0) / total : 0;
  document.getElementById('averageRating').textContent = total ? average.toFixed(1) + '/5' : '—';
  document.getElementById('averageStars').textContent = total ? '★'.repeat(Math.round(average)) + '☆'.repeat(5 - Math.round(average)) : '☆☆☆☆☆';
  document.getElementById('reviewCount').textContent = total + (total === 1 ? ' opinión' : ' opiniones');
  const list = document.getElementById('reviewList');
  list.replaceChildren();
  if (!total) {
    const empty = document.createElement('div');
    empty.className = 'review-empty';
    empty.textContent = 'Aún no hay opiniones. ¡Sé la primera persona en compartir su experiencia!';
    list.appendChild(empty);
    return;
  }
  reviews.slice().reverse().forEach(item => {
    const card = document.createElement('article');
    card.className = 'review-item';
    const stars = document.createElement('div');
    stars.className = 'review-stars';
    stars.textContent = '★'.repeat(Number(item.rating)) + '☆'.repeat(5 - Number(item.rating));
    const name = document.createElement('b');
    name.textContent = item.name;
    const comment = document.createElement('p');
    comment.textContent = item.comment;
    const date = document.createElement('div');
    date.className = 'review-date';
    date.textContent = item.date;
    card.append(stars, name, comment, date);
    list.appendChild(card);
  });
}
document.getElementById('reviewForm').addEventListener('submit', event => {
  event.preventDefault();
  const form = event.currentTarget;
  const name = form.elements.reviewName.value.trim();
  const rating = Number(form.elements.reviewRating.value);
  const comment = form.elements.reviewComment.value.trim();
  if (!name || !comment || rating < 1 || rating > 5) return;
  const reviews = loadReviews();
  reviews.push({ name, rating, comment, date: new Date().toLocaleDateString('es-MX', {year:'numeric', month:'long', day:'numeric'}) });
  try {
    localStorage.setItem(REVIEW_STORAGE_KEY, JSON.stringify(reviews));
    form.reset();
    document.getElementById('reviewNotice').textContent = '¡Gracias! Tu opinión quedó guardada en este navegador.';
    renderReviews();
  } catch (error) {
    document.getElementById('reviewNotice').textContent = 'No se pudo guardar la opinión. Revisa la configuración de almacenamiento de tu navegador.';
  }
});
renderReviews();

</script>
